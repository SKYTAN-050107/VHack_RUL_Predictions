# Copy this file to secrets.toml and fill in your values.
# NEVER commit secrets.toml to version control.

# Google Gemini API
GEMINI_API_KEY = "your_gemini_api_key_here"

# ML Backend API (teammates REST API — not needed in mock mode)
ML_BACKEND_URL = "http://localhost:5000"
ML_API_KEY = "your_ml_backend_api_key_here"

# App Settings
APP_MODE = "development"   # "development" or "production"
USE_MOCK_DATA = "true"     # "true" uses mock data; "false" calls the real ML backend
